# Copy to .env and fill in. Only OPENAI_API_KEY is required — everything
# below has a working default (see src/config.py) and only needs to be set
# to override that default.

OPENAI_API_KEY=sk-...

# --- Models ---
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=3072
# CHAT_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini

# --- Chunking ---
# CHUNK_MIN_TOKENS=500
# CHUNK_MAX_TOKENS=1000
# CHUNK_OVERLAP_RATIO=0.15
# TOKENIZER_ENCODING=cl100k_base

# --- Vector store ---
# COLLECTION_NAME=bank_annual_reports
# HNSW_SPACE=cosine
# HNSW_CONSTRUCTION_EF=200
# HNSW_M=16
# HNSW_SEARCH_EF=100

# --- Retrieval ---
# DENSE_TOP_K=10
# BM25_TOP_K=10
# HYBRID_DENSE_WEIGHT=0.6
# HYBRID_SPARSE_WEIGHT=0.4
# RERANK_TOP_N=5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# USE_RERANKER=true

# --- Multimodal (image captioning) ---
# CAPTION_IMAGES=true
# MIN_IMAGE_SIZE_PX=80
# MAX_IMAGES_PER_PAGE=4

# --- Noise removal ---
# HEADER_FOOTER_MARGIN_RATIO=0.08
# MIN_REPEAT_RATIO_FOR_BOILERPLATE=0.4
